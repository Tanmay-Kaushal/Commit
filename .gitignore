node_modules/

# Frontend build output — generated into backend/public by `npm run build`
# (see vite.config.ts), not source.
backend/public/

# Local SQLite database
backend/dev.db
backend/dev.db-shm
backend/dev.db-wal

# Daily VACUUM INTO snapshots (see cronJob.js backupDatabase)
backend/backups/

# Auto-generated secrets (see persistentDir.js) — real ones on the volume in production
backend/.jwt-secret
backend/.vapid-keys.json

# Env files with secrets — .env.example (if you add one) stays tracked
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
